# GeoSketch frontend configuration
# Copy to `.env` and adjust if the backend does not run on the default address.

# Base URL of the FastAPI backend (no trailing slash). Requests go to
# <VITE_API_BASE_URL>/api/v1/...
# Use the LAN IP (not localhost) when opening the dashboard from another device.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Which tracker the dashboard follows. Must match GEOSKETCH_DEVICE_ID in the
# backend .env and GEOSKETCH_DEVICE_ID in the firmware config.h.
VITE_DEVICE_ID=geosketch-01
