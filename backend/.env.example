# ===========================================================================
# GeoSketch backend configuration
# Copy this file to `backend/.env` and edit it.  Never commit the real `.env`.
# All variables use the GEOSKETCH_ prefix.
# ===========================================================================

# --- Application -----------------------------------------------------------
GEOSKETCH_APP_NAME=GeoSketch API
GEOSKETCH_DEBUG=false

# SQLite by default.  To move to PostgreSQL later, only this line changes, e.g.
# GEOSKETCH_DATABASE_URL=postgresql+psycopg://geosketch:secret@localhost:5432/geosketch
GEOSKETCH_DATABASE_URL=sqlite:///./geosketch.db

# Comma separated list of browser origins allowed to call the API.
GEOSKETCH_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Device authentication -------------------------------------------------
# Format: "device_id:api_key" pairs separated by commas.
# The key is hashed (SHA-256) into the devices table on startup; the plaintext
# value lives only here and in the firmware config.h.
# Generate strong keys, for example: python -c "import secrets;print(secrets.token_urlsafe(24))"
GEOSKETCH_DEVICE_KEYS=geosketch-01:CHANGE-ME-device-key-please

# Journeys are single-tenant by default ("local").  Requests may scope
# themselves with an `X-Owner-Key` header; anything else falls back to this.
GEOSKETCH_DEFAULT_OWNER=local

# --- Reliability / security ------------------------------------------------
GEOSKETCH_MAX_REQUEST_BYTES=65536
GEOSKETCH_RATE_LIMIT_REQUESTS=240
GEOSKETCH_RATE_LIMIT_WINDOW_SECONDS=60
# A device is reported "offline" when no point arrived within this window.
GEOSKETCH_DEVICE_OFFLINE_AFTER_SECONDS=30

# --- Route processing tunables (used by statistics + artwork engine) -------
# Points closer than this to the previous accepted point are treated as
# redundant while drawing the artwork (raw points are always preserved).
GEOSKETCH_MIN_POINT_DISTANCE_M=1.0
# A jump implying a faster speed than this is treated as GPS noise and the
# route is cut instead of drawing a straight line across it.
GEOSKETCH_MAX_PLAUSIBLE_SPEED_KMH=200.0
# A time gap longer than this starts a new route segment.
GEOSKETCH_MAX_GAP_SECONDS=180

# --- Storage ---------------------------------------------------------------
GEOSKETCH_ARTWORK_DIR=../data/artworks
GEOSKETCH_SAMPLE_ROUTES_DIR=../data/sample_routes
